# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.env
.venv
env/
venv/
ENV/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Jupyter
.ipynb_checkpoints/

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Logs
logs/
*.log

# Data (large files — keep structure via .gitkeep)
datasets/raw/*
datasets/external/*
datasets/interim/*
datasets/processed/*
!datasets/**/.gitkeep

# Models & experiments
saved_models/*
!saved_models/.gitkeep
experiments/*
!experiments/.gitkeep

# Reports
reports/*
!reports/.gitkeep

# OS
.DS_Store
Thumbs.db

# Secrets
*.pem
*.key
secrets/
