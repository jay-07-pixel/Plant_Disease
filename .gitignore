# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.env
.venv
env/
venv/
ENV/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Jupyter
.ipynb_checkpoints/

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Logs
logs/*
!logs/.gitkeep
*.log

# Data (large files — keep structure via .gitkeep)
datasets/raw/*
datasets/external/*
datasets/interim/*
datasets/processed/*
!datasets/**/.gitkeep

# Models & experiment run artifacts
saved_models/*
!saved_models/.gitkeep
experiments/**/tensorboard/

# Reports (track pipeline outputs; datasets remain excluded)
# reports/ is versioned intentionally

# OS
.DS_Store
Thumbs.db

# Secrets
*.pem
*.key
secrets/
